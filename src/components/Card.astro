---
const headline = Astro.props.headline;
const text = Astro.props.text;
---

<h1>{headline}</h1>
<p>{text}</p>
<slot />

<style>
  p {
    color: #525252;
    padding-inline: 5rem;
    padding-block: 2rem;
    font-size: 20px;
    font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
    font-weight: 300;
  }

  h1 {
    padding-top: 5rem;
    color: black;
    text-align: center;
    font-size: 35px;
    font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
    font-weight: bold;
    font-style: italic;
  }
</style>
