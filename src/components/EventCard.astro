---
// Props du kan sende til komponenten
const { date, title, limited, location, image, place, time, billet } = Astro.props;
---

<div class="event-row">
  <div class="date">{date}</div>
  <div><strong>{title}</strong></div>
  <div class="limited">{limited}</div>
  <div class="location">{location}</div>
  <button class="toggle-info-btn">+</button>
  <a class="btn-tilmeld" href="#">TILMELD</a>

  <div class="event-info">
    <div class="event-grid">
      <div class="event-left">
        <img src={image} alt={title} />
      </div>
      <div class="event-right">
        <h4>{title}</h4>
        <p>{place}</p>
        <p>{time}</p>
        <p><strong>Billettype:</strong> {billet}</p>
      </div>
    </div>
  </div>
</div>

<style>
  /* === Generelt layout === */
  .calendar {
    background-color: black;
    color: black;
    padding: 8rem 2rem;
    margin: auto;
  }

  .calendar-section:first-of-type {
    margin-top: 3rem;
  }

  .calendar h2 {
    color: black;
    font-family: Arial, Helvetica, sans-serif;
    font-size: 2rem;
    text-align: center;
    font-style: italic;
    font-weight: 700;
    margin-bottom: 0.25rem;
  }

  .calendar p {
    font-family: Arial, Helvetica, sans-serif;
    text-align: center;
  }

  /* === Event-row (desktop default) === */
  .event-row {
    color: black;
    font-family: Arial, Helvetica, sans-serif;
    font-size: 16px;
    padding: 5px 4rem;
    display: grid;
    grid-template-columns: 1fr 2fr 1fr 2fr auto;
    align-items: center;
    border-top: 1px solid #c4c4c4;
    position: relative;
  }

  /* === Dato + badge === */
  .date {
    font-size: 18px;
    border-radius: 50%;
    display: flex;
    align-items: start;
    justify-content: start;
  }

  .limited {
    margin-top: 0.2rem;
    color: #121212;
    background-color: rgb(234, 234, 234);
    font-size: 0.75rem;
    padding: 7px 16px;
    max-width: 76px;
    border-radius: 16px;
    display: flex;
    justify-content: center;
  }

  /* === Tilmeld-knap === */
  .btn-tilmeld {
    text-decoration: none;
    font-size: 0.85rem;
    background-color: #0f62fe;
    padding: 0.4rem 0.75rem;
    border: none;
    cursor: pointer;
    color: white;
    transition: background-color 0.2s ease;
  }

  .btn-tilmeld:hover {
    background-color: #f8f8f8;
    color: black;
    border: 1px solid black;
  }

  /* === Event info (udfoldet panel) === */
  .event-info {
    max-height: 0;
    overflow: hidden;
    opacity: 0;
    grid-column: 1 / -1;
    padding: 1rem 0;
    transition: all 0.4s ease;
    font-size: 14px;
  }

  /* === Grid i udfoldet event === */
  .event-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  .event-left img {
    width: 50%;
    height: auto;
    object-fit: contain;
    padding: 1rem;
  }

  .event-left h4 {
    margin: 0 0 0.5rem;
    font-size: 1rem;
    font-weight: 600;
  }

  .event-right h4,
  .event-right p {
    margin: 0 0 0.5rem;
    text-align: right;
  }

  /* === Toggle-knap === */
  .toggle-info-btn {
    background: none;
    border: none;
    font-size: 1.5rem;
    cursor: pointer;
    margin-left: 1rem;
    display: none; /* Skjules på desktop */
  }

  /* === Desktop hover-funktion === */
  @media (min-width: 769px) {
    .event-row:hover .event-info {
      max-height: 700px;
      opacity: 1;
    }

    .toggle-info-btn {
      display: none;
    }
  }

  /* === Mobil-visning === */
  @media (max-width: 768px) {
    .calendar {
      padding: 8rem 0.2rem;
    }

    .event-row {
      font-size: 14px;
      padding: 5px 0.5rem;
      grid-template-columns: 1fr 2fr 1fr 1fr auto;
      gap: 10px;
      border-top: 1px solid #000;
    }

    .date {
      font-size: 14px;
    }

    .limited,
    .location {
      display: none;
    }

    .event img {
      max-width: 160px;
      z-index: 100;
    }

    .toggle-info-btn {
      display: inline-block;
    }

    .event-info {
      max-height: 0;
      opacity: 0;
    }

    .event-row.open .event-info {
      max-height: 500px;
      opacity: 1;
    }
  }
</style>
