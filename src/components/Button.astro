---
const buttontext = Astro.props.buttontext;
---

<div class="button1">
  <button>
    <p>{buttontext}</p>
  </button>
</div>
<style>
  .button1 {
    display: flex;
    justify-content: center;
    padding-bottom: 3rem;
  }

  button {
    background-color: #2a45ff;
    width: 350px; /*fixed width*/
    padding: 10px 0;
    border: none;
    cursor: pointer;
    color: white;
    white-space: nowrap;
  }

  button:hover {
    background-color: #f8f8f8;
    color: black;
    transition: 300ms;
    border: solid;
    border-width: 1px;
  }
</style>
