---
import Card from "./Card.astro";
import Button from "./Button.astro";
import Form from "./Form.astro";
---

<div class="grid_1-1">
  <div>
    <Card headline="BAREEN DANS" text="Bareen x Dansevand inviterer dig til Bareen Dans. Fire uger med svedige moves, tunge beats og fællesskab med puls. Hver uge lander en ny dansestil: fra Hiphop og Afrobeats til House og Funk. Op til tre workshops om ugen, hvor stemningen minder mere om klub end fitnesscenter. Det handler ikke om at kunne trinene, det handler om at være med. Alle niveauer er velkomne, og ja, selvfølgelig er der iskold Dansevand til alle, der danser med. Men heads up: pladserne er få og fyldes hurtigt." />
    <div class="show-form-btn" data-target="form1">
      <Button buttontext="TILMELD BAREEN DANS EVENT" />
    </div>
    <div class="form-container form1" style="display: none;">
      <Form />
    </div>
  </div>
  <div>
    <div class="slideshow">
      <div class="slide">
        <img src="/imgs/dansevand.webp" alt="Dansevand" />
      </div>
      <div class="slide">
        <img src="/imgs/dansevanddj.webp" alt="Dansevand med DJ" />
      </div>
      <div class="slide">
        <img src="/imgs/dansevandmedis.webp" alt="Dansevand med is" />
      </div>
    </div>
  </div>
</div>

<div id="presale" class="grid_1-1">
  <div class="order">
    <Card class="order" headline="LIMITED EDITION DROP" text="Drop det kedelige træningstøj og gør plads til noget med karakter. Som en del af Bareen Dans slipper vi en eksklusiv Limited Edition kollektion, designet til dancefloor og afterparty. Du kan svede i det, leve i det og se brandgodt ud imens. Skriv dig op for og få pre-acess når kollektionen dropper og snup dit favorit item før nogen andre." />
    <div class="show-form-btn" data-target="form2">
      <Button buttontext="FÅ PRE-ACCESS" />
    </div>
    <div class="form-container form2" style="display: none;">
      <Form />
    </div>
  </div>

  <div>
    <div class="slideshow">
      <div class="slide">
        <img src="/imgs/bareenkasket.webp" alt="Bareen kasket" />
      </div>
      <div class="slide">
        <img src="/imgs/bareendame.webp" alt="Bareen dame" />
      </div>
      <div class="slide">
        <img src="/imgs/bareenmennesker.webp" alt="Bareen mennesker" />
      </div>
    </div>
  </div>
</div>

<style>
  @media (min-width: 900px) {
    .grid_1-1 {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 10px;
    }
    .order {
      order: 1;
    }
  }
  @media (max-width: 768px) {
  }

  img {
    display: block;
    margin: auto;
    width: 60%;
  }

  /********** Slideshow lavet med hjælp fra chatGPT **********/

  .slideshow {
    position: relative;
    max-width: 100%;
    height: 600px;
    margin: auto;
    overflow: hidden;
  }

  .slide {
    position: absolute;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 1s ease;
  }

  @keyframes slideAnimation {
    0% {
      opacity: 0;
    }
    5% {
      opacity: 1;
    }
    25% {
      opacity: 1;
    }
    30% {
      opacity: 0;
    }
    100% {
      opacity: 0;
    }
  }

  .slideshow .slide:nth-child(1) {
    animation: slideAnimation 12s infinite;
    animation-delay: 0s;
  }

  .slideshow .slide:nth-child(2) {
    animation: slideAnimation 12s infinite;
    animation-delay: 4s;
  }

  .slideshow .slide:nth-child(3) {
    animation: slideAnimation 12s infinite;
    animation-delay: 8s;
  }
</style>

<!-- /********** From vis og vis ikke lavet med hjælp fra chatGPT **********/ -->
<script>
  document.addEventListener("DOMContentLoaded", () => {
    const buttons = document.querySelectorAll(".show-form-btn");

    buttons.forEach((btn) => {
      btn.addEventListener("click", () => {
        const targetClass = btn.getAttribute("data-target");
        const form = document.querySelector(`.form-container.${targetClass}`);

        if (form) {
          form.style.display = "block";
          form.scrollIntoView({ behavior: "smooth" });
        }
      });
    });
  });
</script>
