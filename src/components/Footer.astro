<style>

.grid_2 {
    display: grid;
    grid-template-columns: 1fr 1fr;
    padding: 3rem;
}  

input, 
textarea {
    background-color: black;
    border: none;
    padding: 8px;
    width: 100%;
    box-sizing: border-box;
}



    dl {
        color: black;
        display: grid;
        grid-template-columns: 1fr 1fr;
        line-height: 1.5;
        font-family: Arial, Helvetica, sans-serif;
        font-size: small;
        font-weight: bold;
    }

    h3 {
        color: black;
        font-family: Arial, Helvetica, sans-serif;
    }
.logo {
    width: 25%;
}

</style>
