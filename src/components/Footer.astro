    <form>
        <div class="input_box">
        <input type="text" placeholder="E-mail">
        </div>
        <Button buttontext="BLIV MEDLEM"></button>
    </form>
</div>

<div>
    <h3>KUNDESERVICE</h3>
    <dl>
        <dt>Man - Fre</dt>
        <dd> 9.00 - 16.00</dd>
        <dt>Weekend & helligdage</dt>
